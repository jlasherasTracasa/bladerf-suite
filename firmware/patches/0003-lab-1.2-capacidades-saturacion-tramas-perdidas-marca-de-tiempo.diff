+    c_spec_frames <= c_spec_frames_i;
     c_samples  <= cs_samples;
     c_fifo_ovf <= cs_ovf;
 
+    -- ------------------------------------------------------------------------
+    -- F10: telemetría adicional (dominio rx_clock)
+    --
+    -- * Saturación del ADC: el AD9361 entrega 12 bit en complemento a dos, de modo que
+    --   el fondo de escala son los códigos +2047 (0x7FF) y -2048 (0x800). Una muestra
+    --   cuenta como saturada si I o Q valen alguno de los dos (un solo incremento por
+    --   muestra). Cualquier señal que pase del fondo de escala se recorta contra esos
+    --   códigos, así que su frecuencia relativa mide el exceso de ganancia (el
+    --   convertidor ya no es lineal: aparecen armónicos e intermodulación).
+    --   c_adc_sat acumula desde el último CLEAR; c_adc_satwin conserva el total de la
+    --   última ventana completa de 2^16 muestras (≈ 1,1 ms a 61,44 Msps), útil para
+    --   leer "% saturado" sin restar contadores.
+    -- * Tramas de espectro perdidas: con rx_mux = 3 cada palabra que llega con la FIFO
+    --   de muestras llena se pierde (ya cuenta en c_fifo_ovf). Aquí se cuenta cada
+    --   TRAMA con al menos una palabra perdida (un aviso por trama, no por palabra).
+    --   El comienzo de trama se detecta por el cambio de c_spec_frames.
+    -- * Marca de tiempo libre: contador de 64 bit que avanza con cada muestra válida
+    --   del canal 0 del ADC (tasa de muestra), sin reinicio por CLEAR ni por rx_reset
+    --   (solo vale 0 al cargar la FPGA). 2^64 muestras a 122,88 Msps = 4760 años.
+    -- ------------------------------------------------------------------------
+    diag2_proc : process(rx_clock)
+        variable sv, lost : boolean;
+    begin
+        if rising_edge(rx_clock) then
+            -- tiempo libre
+            if adc_streams(0).data_v = '1' then
+                tm_cnt <= tm_cnt + 1;
+            end if;
+            -- comienzo de trama de espectro
+            spec_frames_d <= c_spec_frames_i;
+            if c_spec_frames_i /= spec_frames_d then
+                frame_lost <= '0';
+            end if;
+            if spec_cfg_clear /= clear_prev2 then
+                clear_prev2 <= spec_cfg_clear;
+                cs_sat      <= (others => '0');
+                cs_satwin   <= (others => '0');
+                win_acc     <= (others => '0');
+                win_cnt     <= (others => '0');
+                cs_sdrop    <= (others => '0');
+                frame_lost  <= '0';
+            else
+                if rx_enable = '1' and adc_streams(sel_ch).data_v = '1' then
+                    sv := adc_streams(sel_ch).data_i(11 downto 0) = x"7FF" or
+                          adc_streams(sel_ch).data_i(11 downto 0) = x"800" or
+                          adc_streams(sel_ch).data_q(11 downto 0) = x"7FF" or
+                          adc_streams(sel_ch).data_q(11 downto 0) = x"800";
+                    win_cnt <= win_cnt + 1;
+                    if sv then
+                        cs_sat  <= cs_sat + 1;
+                        win_acc <= win_acc + 1;
+                    end if;
+                    if win_cnt = x"FFFF" then
+                        -- ventana completa: la muestra actual ya cuenta en ella
+                        if sv then
+                            cs_satwin <= resize(win_acc, 32) + 1;
+                        else
+                            cs_satwin <= resize(win_acc, 32);
+                        end if;
+                        win_acc <= (others => '0');
+                    end if;
+                end if;
+                lost := false;
+                if spec_run = '1' and rx_enable = '1' and sample_fifo.wfull = '1' then
+                    for i in mux_streams'range loop
+                        if mux_streams(i).data_v = '1' and adc_controls(i).enable = '1' then
+                            lost := true;
+                        end if;
+                    end loop;
+                end if;
+                if lost and frame_lost = '0' then
+                    frame_lost <= '1';
+                    cs_sdrop   <= cs_sdrop + 1;
+                end if;
+            end if;
+        end if;
+    end process;
+    c_adc_sat    <= cs_sat;
+    c_adc_satwin <= cs_satwin;
+    c_spec_drop  <= cs_sdrop;
+    c_time       <= tm_cnt;
+
 
     -- RX Trigger
     rxtrig : entity work.trigger(async)
