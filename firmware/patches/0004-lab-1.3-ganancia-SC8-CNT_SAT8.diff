+                when 1      => ovf := t(3) /= t(2);                                   r := v(10 downto 0) & '0';
+                when 2      => ovf := not (t(3 downto 1) = "000" or t(3 downto 1) = "111"); r := v(9 downto 0) & "00";
+                when others => ovf := not (t = "0000" or t = "1111");                 r := v(8 downto 0) & "000";
+            end case;
