index 0000000..9d4a1dc
--- /dev/null
+++ b/hdl/fpga/platforms/bladerf-micro/vhdl/lab/sdf_mult.vhd
@@ -0,0 +1,200 @@
+-- sdf_mult.vhd — Multiplicador de twiddles tras una etapa SDF radix-2^2.
+--
+-- Se instancia detrás de las etapas con E par y E >= 2. Rotación compleja
+--   (a + jb)(wr + j wi),  wr = round(65536 cos θ),  wi = round(-65536 sin θ)
+--   re' = (a*wr - b*wi + 32768) >> 16 ;  im' = (a*wi + b*wr + 32768) >> 16
+-- La posición p cuenta los datos válidos del flujo; la ROM se lee con
+--   etapa II (par, no primera): tramas de 4D, q = bitrev2(p[E+1:E]), n = p[E-1:0],
+--       índice m = n*q en la tabla W_{4D}^m
+--   etapa sola (primera con E par): tramas de 2D, si p[E] = 1 el índice es n (tabla
+--       W_8192^n para E=12) o 2n (tabla W_{4D}^m para el resto); si p[E] = 0, rotación 1.
+-- Pipeline de 5 pasos (índice, ROM, registro de salida de la ROM, productos, suma y redondeo), todo con 'ce'.
+-- Los productos 25x18 se mapean en bloques DSP; no se usa ninguna IP con licencia.
+
+library ieee;
+    use ieee.std_logic_1164.all;
+    use ieee.numeric_std.all;
+
+library work;
+    use work.lab_rom_p.all;
+
+entity sdf_mult is
+    generic (
+        E : natural := 10
+    );
+    port (
+        clk      : in  std_logic;
+        rst      : in  std_logic;
+        ce       : in  std_logic;
+        lone     : in  std_logic;
+        din_re   : in  signed(24 downto 0);
+        din_im   : in  signed(24 downto 0);
+        vin      : in  std_logic;
+        dout_re  : out signed(24 downto 0) := (others => '0');
+        dout_im  : out signed(24 downto 0) := (others => '0');
+        vout     : out std_logic := '0'
+    );
+end entity;
+
+architecture rtl of sdf_mult is
+
+    signal p      : unsigned(E+1 downto 0) := (others => '0');
+    signal idx    : natural range 0 to 12287 := 0;
+    function addr_bits(e : natural) return natural is
+    begin
+        if e = 12 then return 12; else return e + 2; end if;
+    end function;
+    constant AW   : natural := addr_bits(E);   -- bits de dirección de la ROM
+    signal idx_u  : unsigned(13 downto 0) := (others => '0');
+    signal idx_r  : natural range 0 to 12287 := 0;
+    signal p_re, p_im : signed(24 downto 0) := (others => '0');
+    signal vp     : std_logic := '0';
+    signal tw_q   : std_logic_vector(35 downto 0) := (others => '0');
+    signal tw_r   : std_logic_vector(35 downto 0) := (others => '0');
+    signal a1, b1 : signed(24 downto 0) := (others => '0');
+    signal v00    : std_logic := '0';
+    signal a0, b0 : signed(24 downto 0) := (others => '0');
+    signal v0, v1 : std_logic := '0';
+    signal wr0, wi0 : signed(17 downto 0);
+    signal pa, pb, pc, pd : signed(42 downto 0) := (others => '0');
+
+begin
+
+    -- Índice en la ROM
+    index_calc : process(all)
+        variable n  : natural;
+        variable qr : natural;
+        variable m  : natural;
+    begin
+        n := to_integer(p(E-1 downto 0));
+        case p(E+1 downto E) is
+            when "00"   => qr := 0;
+            when "01"   => qr := 2;
+            when "10"   => qr := 1;
+            when others => qr := 3;
+        end case;
+        if lone = '1' then
+            if p(E) = '1' then
+                if E = 12 then m := n; else m := 2*n; end if;
+            else
+                m := 0;
+            end if;
+        else
+            m := n * qr;
+        end if;
+        if m > 12287 then m := 0; end if;
+        idx <= m;
+    end process;
+
+    idx_u <= to_unsigned(idx_r, 14);
+    wr0 <= signed(tw_r(35 downto 18));
+    wi0 <= signed(tw_r(17 downto 0));
+
+    -- ROM registrada (una ROM por E)
+    g_rom2 : if E = 2 generate
+        -- ROM como RAM inicializada (nunca se escribe): Quartus la mapea a M10K con contenido inicial
+        signal rom_s : tw_rom_t(TW_ROM_2'range) := TW_ROM_2;
+    begin
+        process(clk) begin
+            if rising_edge(clk) then
+                if ce = '1' then tw_q <= rom_s(to_integer(idx_u(AW-1 downto 0))); end if;
+            end if;
+        end process;
+    end generate;
+    g_rom4 : if E = 4 generate
+        -- ROM como RAM inicializada (nunca se escribe): Quartus la mapea a M10K con contenido inicial
+        signal rom_s : tw_rom_t(TW_ROM_4'range) := TW_ROM_4;
+    begin
+        process(clk) begin
+            if rising_edge(clk) then
+                if ce = '1' then tw_q <= rom_s(to_integer(idx_u(AW-1 downto 0))); end if;
+            end if;
+        end process;
+    end generate;
+    g_rom6 : if E = 6 generate
+        -- ROM como RAM inicializada (nunca se escribe): Quartus la mapea a M10K con contenido inicial
+        signal rom_s : tw_rom_t(TW_ROM_6'range) := TW_ROM_6;
+    begin
+        process(clk) begin
+            if rising_edge(clk) then
+                if ce = '1' then tw_q <= rom_s(to_integer(idx_u(AW-1 downto 0))); end if;
+            end if;
+        end process;
+    end generate;
+    g_rom8 : if E = 8 generate
+        -- ROM como RAM inicializada (nunca se escribe): Quartus la mapea a M10K con contenido inicial
+        signal rom_s : tw_rom_t(TW_ROM_8'range) := TW_ROM_8;
+    begin
+        process(clk) begin
+            if rising_edge(clk) then
+                if ce = '1' then tw_q <= rom_s(to_integer(idx_u(AW-1 downto 0))); end if;
+            end if;
+        end process;
+    end generate;
+    g_rom10 : if E = 10 generate
+        -- ROM como RAM inicializada (nunca se escribe): Quartus la mapea a M10K con contenido inicial
+        signal rom_s : tw_rom_t(TW_ROM_10'range) := TW_ROM_10;
+    begin
+        process(clk) begin
+            if rising_edge(clk) then
+                if ce = '1' then tw_q <= rom_s(to_integer(idx_u(AW-1 downto 0))); end if;
+            end if;
+        end process;
+    end generate;
+    g_rom12 : if E = 12 generate
+        -- ROM como RAM inicializada (nunca se escribe): Quartus la mapea a M10K con contenido inicial
+        signal rom_s : tw_rom_t(TW_ROM_12'range) := TW_ROM_12;
+    begin
+        process(clk) begin
+            if rising_edge(clk) then
+                if ce = '1' then tw_q <= rom_s(to_integer(idx_u(AW-1 downto 0))); end if;
+            end if;
+        end process;
+    end generate;
+
+    pipe : process(clk)
+        variable sr, si : signed(43 downto 0);
+    begin
+        if rising_edge(clk) then
+            if rst = '1' then
+                p    <= (others => '0');
+                vp   <= '0';
+                v00  <= '0';
+                v0   <= '0';
+                v1   <= '0';
+                vout <= '0';
+            elsif ce = '1' then
+                -- paso P: índice de la ROM de la posición actual y registro de la entrada
+                idx_r <= idx;
+                p_re  <= din_re;
+                p_im  <= din_im;
+                vp    <= vin;
+                if vin = '1' then
+                    p <= p + 1;
+                end if;
+                -- paso A: lectura de la ROM (tw_q se registra en el proceso de la ROM) y entrada alineada
+                a0 <= p_re;
+                b0 <= p_im;
+                v00 <= vp;
+                -- paso A2: registro de salida de la ROM (se mapea al registro de salida de la M10K)
+                tw_r <= tw_q;
+                a1 <= a0;
+                b1 <= b0;
+                v0 <= v00;
+                -- paso B: productos
+                pa <= a1 * wr0;
+                pb <= b1 * wi0;
+                pc <= a1 * wi0;
+                pd <= b1 * wr0;
+                v1 <= v0;
+                -- paso C: suma y redondeo
+                sr := resize(pa, 44) - resize(pb, 44) + 32768;
+                si := resize(pc, 44) + resize(pd, 44) + 32768;
+                dout_re <= sr(40 downto 16);
+                dout_im <= si(40 downto 16);
+                vout    <= v1;
+            end if;
+        end if;
+    end process;
+
+end architecture;
diff --git a/hdl/fpga/platforms/bladerf-micro/vhdl/lab/sdf_stage.vhd b/hdl/fpga/platforms/bladerf-micro/vhdl/lab/sdf_stage.vhd
new file mode 100644
index 0000000..eebc518
--- /dev/null
+++ b/hdl/fpga/platforms/bladerf-micro/vhdl/lab/sdf_stage.vhd
@@ -0,0 +1,189 @@
+-- sdf_stage.vhd — Etapa de mariposa de una FFT SDF (single-path delay feedback)
+-- por diezmado en frecuencia, parte del motor de espectro del proyecto BladeRF Lab.
+--
+-- Una etapa con retardo D = 2^E recibe el flujo de muestras complejas y lo
+-- procesa en tramas de 2D elementos: durante la primera mitad (fase 0) guarda
+-- la muestra en la línea de retardo y emite la diferencia de la trama anterior;
+-- durante la segunda (fase 1) emite la suma a+b y guarda la diferencia a-b.
+-- Orden de salida de una trama: [sumas(D), diferencias(D)].
+--
+-- Radix-2^2 (He & Torkelson): en las etapas "II" (E par que no es la primera) la
+-- segunda operando se multiplica por -j en las secciones impares de la trama de
+-- 4D elementos; el twiddle general lo aplica después sdf_mult.
+--
+-- Anchos: la etapa E recibe WD = min(25, 29-E) bits y entrega OW = min(25, 30-E).
+-- Cuando WD+1 supera 25 (E <= 4) la salida se desplaza un bit con redondeo
+-- (v + 1) >> 1. Todo es exacto al bit con firmware/model/spec_model.c.
+--
+-- Todo el estado avanza con 'ce' (un pulso por muestra), no con cada ciclo de
+-- reloj. 'vin' marca que el dato de entrada pertenece al flujo; 'vout' se activa
+-- desde la primera fase 1 (antes la salida de la fase 0 no es válida).
+
+library ieee;
+    use ieee.std_logic_1164.all;
+    use ieee.numeric_std.all;
+
+entity sdf_stage is
+    generic (
+        E : natural := 12
+    );
+    port (
+        clk      : in  std_logic;
+        rst      : in  std_logic;
+        ce       : in  std_logic;
+        ii_mode  : in  std_logic;
+        din_re   : in  signed(24 downto 0);
+        din_im   : in  signed(24 downto 0);
+        vin      : in  std_logic;
+        dout_re  : out signed(24 downto 0) := (others => '0');
+        dout_im  : out signed(24 downto 0) := (others => '0');
+        vout     : out std_logic := '0'
+    );
+end entity;
+
+architecture rtl of sdf_stage is
+
+    function minint(a, b : integer) return integer is
+    begin
+        if a < b then return a; else return b; end if;
+    end function;
+
+    constant D      : natural := 2**E;
+    constant OW     : natural := minint(25, 30 - E);
+    constant SHIFT  : boolean := (E <= 4);
+
+    signal cnt      : unsigned(E+1 downto 0) := (others => '0');
+    signal started  : std_logic := '0';
+    signal adv      : std_logic;
+
+    signal d_re, d_im : signed(OW-1 downto 0) := (others => '0');   -- dato antiguo (salida de la línea de retardo)
+    signal w_re, w_im : signed(OW-1 downto 0);                       -- dato a guardar
+    signal o_re, o_im : signed(OW-1 downto 0);                       -- dato de salida (combinacional)
+
+    signal phase, section : std_logic;
+
+begin
+
+    adv     <= ce and vin;
+    phase   <= cnt(E);
+    section <= cnt(E+1);
+
+    -- Mariposa (combinacional). La rotación -j se resuelve intercambiando suma y resta
+    -- (sin negar nada), y en las etapas con desplazamiento el redondeo (+1) se aplica al
+    -- guardar la muestra de la primera mitad (se almacena a+1), de modo que cada camino
+    -- tiene un único sumador:  (a+1) +/- b  >> 1  =  (a +/- b + 1) >> 1.
+    butterfly : process(all)
+        variable xr, xi   : signed(OW downto 0);
+        variable xre, xim : signed(OW downto 0);
+        variable ar, ai   : signed(OW downto 0);
+        variable sr, si   : signed(OW downto 0);
+        variable dr, di   : signed(OW downto 0);
+        variable xs_re, xs_im : signed(OW downto 0);
+        variable rot      : boolean;
+    begin
+        xre := resize(resize(din_re, OW), OW+1);
+        xim := resize(resize(din_im, OW), OW+1);
+        rot := (ii_mode = '1' and section = '1');
+        ar := resize(d_re, OW+1);
+        ai := resize(d_im, OW+1);
+        if rot then
+            -- x' = -j*x = (xim, -xre)
+            sr := ar + xim;  dr := ar - xim;
+            si := ai - xre;  di := ai + xre;
+        else
+            sr := ar + xre;  dr := ar - xre;
+            si := ai + xim;  di := ai - xim;
+        end if;
+        xs_re := xre;
+        xs_im := xim;
+        if SHIFT then
+            xs_re := xre + 1;
+            xs_im := xim + 1;
+        end if;
+
+        if phase = '0' then
+            o_re <= d_re;
+            o_im <= d_im;
+            w_re <= resize(xs_re, OW);
+            w_im <= resize(xs_im, OW);
+        else
+            if SHIFT then
+                o_re <= sr(OW downto 1);   o_im <= si(OW downto 1);
+                w_re <= dr(OW downto 1);   w_im <= di(OW downto 1);
+            else
+                o_re <= resize(sr, OW);    o_im <= resize(si, OW);
+                w_re <= resize(dr, OW);    w_im <= resize(di, OW);
+            end if;
+        end if;
+    end process;
+
+    -- Contador, validez y registro de salida
+    ctrl : process(clk)
+    begin
+        if rising_edge(clk) then
+            if rst = '1' then
+                cnt     <= (others => '0');
+                started <= '0';
+                vout    <= '0';
+            elsif ce = '1' then
+                if vin = '1' then
+                    cnt <= cnt + 1;
+                    dout_re <= resize(o_re, 25);
+                    dout_im <= resize(o_im, 25);
+                    if phase = '1' then
+                        started <= '1';
+                        vout    <= '1';
+                    else
+                        vout    <= started;
+                    end if;
+                else
+                    vout <= '0';
+                end if;
+            end if;
+        end if;
+    end process;
+
+    -- Línea de retardo en RAM (D >= 16)
+    gen_ram : if E >= 4 generate
+        type ram_t is array (0 to D-1) of std_logic_vector(2*OW-1 downto 0);
+        signal mem   : ram_t;
+        attribute ramstyle : string;
+        attribute ramstyle of mem : signal is "M10K";
+        signal raddr : unsigned(E-1 downto 0);
+        signal rdata : std_logic_vector(2*OW-1 downto 0) := (others => '0');
+    begin
+        raddr <= cnt(E-1 downto 0) + 1;   -- lectura adelantada: la dirección del siguiente ciclo
+        process(clk)
+        begin
+            if rising_edge(clk) then
+                if adv = '1' then
+                    mem(to_integer(cnt(E-1 downto 0))) <= std_logic_vector(w_re) & std_logic_vector(w_im);
+                    rdata <= mem(to_integer(raddr));
+                end if;
+            end if;
+        end process;
+        d_re <= signed(rdata(2*OW-1 downto OW));
+        d_im <= signed(rdata(OW-1 downto 0));
+    end generate;
+
+    -- Línea de retardo en registros (D < 16)
+    gen_sr : if E < 4 generate
+        type sr_t is array (0 to D-1) of std_logic_vector(2*OW-1 downto 0);
+        signal sr : sr_t := (others => (others => '0'));
+    begin
+        process(clk)
+        begin
+            if rising_edge(clk) then
+                if adv = '1' then
+                    sr(0) <= std_logic_vector(w_re) & std_logic_vector(w_im);
+                    for i in 1 to D-1 loop
+                        sr(i) <= sr(i-1);
+                    end loop;
+                end if;
+            end if;
+        end process;
+        d_re <= signed(sr(D-1)(2*OW-1 downto OW));
+        d_im <= signed(sr(D-1)(OW-1 downto 0));
+    end generate;
+
+end architecture;
diff --git a/hdl/fpga/platforms/bladerf-micro/vhdl/lab/spec_acc_ram.vhd b/hdl/fpga/platforms/bladerf-micro/vhdl/lab/spec_acc_ram.vhd
new file mode 100644
index 0000000..a8fddf8
--- /dev/null
+++ b/hdl/fpga/platforms/bladerf-micro/vhdl/lab/spec_acc_ram.vhd
@@ -0,0 +1,40 @@
+-- spec_acc_ram.vhd — RAM de acumulación del motor de espectro: 8192 x 64 bit,
+-- un puerto de escritura y un puerto de lectura síncrona (lectura antigua si
+-- coinciden las direcciones). Se infiere como M10K; no es una IP con licencia.
+
+library ieee;
+    use ieee.std_logic_1164.all;
+    use ieee.numeric_std.all;
+
+entity spec_acc_ram is
+    port (
+        clk   : in  std_logic;
+        we    : in  std_logic;
+        waddr : in  unsigned(12 downto 0);
+        wdata : in  unsigned(63 downto 0);
+        raddr : in  unsigned(12 downto 0);
+        rden  : in  std_logic;
+        q     : out unsigned(63 downto 0)
+    );
+end entity;
+
+architecture rtl of spec_acc_ram is
+    type ram_t is array (0 to 8191) of unsigned(63 downto 0);
+    signal mem : ram_t;
+    attribute ramstyle : string;
+    attribute ramstyle of mem : signal is "M10K";
+    signal q_r : unsigned(63 downto 0) := (others => '0');
+begin
+    process(clk)
+    begin
+        if rising_edge(clk) then
+            if we = '1' then
+                mem(to_integer(waddr)) <= wdata;
+            end if;
+            if rden = '1' then
+                q_r <= mem(to_integer(raddr));
+            end if;
+        end if;
+    end process;
+    q <= q_r;
+end architecture;
diff --git a/hdl/fpga/platforms/bladerf-micro/vhdl/lab/spec_engine.vhd b/hdl/fpga/platforms/bladerf-micro/vhdl/lab/spec_engine.vhd
new file mode 100644
index 0000000..7a69559
--- /dev/null
+++ b/hdl/fpga/platforms/bladerf-micro/vhdl/lab/spec_engine.vhd
@@ -0,0 +1,536 @@
+-- spec_engine.vhd — Motor de espectro promediado en FPGA (BladeRF Lab).
+--
+-- Flujo de datos (todo con 'ce' = un pulso por muestra, salvo la lectura de salida):
+--   muestra I/Q de 12 bits -> ventana Blackman-Harris Q15 (ROM) -> FFT SDF radix-2^2
+--   (spec_fft) -> |X|^2 -> acumulación exacta de K tramas en una RAM de 64 bit por bin
+--   (dos bancos en ping-pong: ciclo de trabajo del 100 %) -> lectura en orden
+--   fftshift -> palabra {E[5:0], M[25:0]} -> trama de salida.
+--
+-- Trama de salida (palabras de 32 bits; bits [15:0] = I y [31:16] = Q del par que
+-- ve el host con SC16_Q11):
+--   w0 = 0x4C415031 ("LAP1"), w1 = 0xB3BEAFCE (~w0), w2 = {K[15:0], N[15:0]},
+--   w3 = contador de trama, w4/w5 = marca de tiempo de la primera muestra del grupo
+--   (bajos/altos), w6 = {15'b0, perdida, 8'h01 (versión), 8'h08 (palabras de cabecera)},
+--   w7 = palabras totales de la trama (con relleno), luego N potencias (bin -N/2 ... N/2-1)
+--   y relleno de ceros hasta múltiplo de 2048 palabras si pad = 1.
+-- Potencia: valor = M * 2^E donde M = (acc >> E)[25:0], E = max(0, msb(acc) - 25).
+-- acc = suma de |X|^2 sobre K tramas, con X = 0.5 * FFT(x*w) (x en cuentas Q11).
+--
+-- La configuración (log2n, k, pad) se latchea al arrancar; si cambia con el motor
+-- activo, este se reinicia. Con rst = 1 todo queda parado. Requisito: 'ce' no más rápido
+-- que una vez por ciclo de reloj (los datos de la FIFO de salida se emiten a 1 palabra/ciclo).
+
+library ieee;
+    use ieee.std_logic_1164.all;
+    use ieee.numeric_std.all;
+
+library work;
+    use work.lab_rom_p.all;
+
+entity spec_engine is
+    port (
+        clk        : in  std_logic;
+        rst        : in  std_logic;
+        ce         : in  std_logic;
+        din_re     : in  signed(11 downto 0);
+        din_im     : in  signed(11 downto 0);
+        ts         : in  unsigned(63 downto 0);
+        cfg_log2n  : in  unsigned(3 downto 0);
+        cfg_k      : in  unsigned(15 downto 0);
+        cfg_pad    : in  std_logic;
+        clr        : in  std_logic;
+        out_word   : out std_logic_vector(31 downto 0);
+        out_valid  : out std_logic;
+        cnt_fft_frames  : out unsigned(31 downto 0);
+        cnt_spec_frames : out unsigned(31 downto 0);
+        cnt_late        : out unsigned(31 downto 0);
+        cnt_words       : out unsigned(31 downto 0)
+    );
+end entity;
+
+architecture rtl of spec_engine is
+
+    constant MAGIC0 : std_logic_vector(31 downto 0) := x"4C415031";
+    constant MAGIC1 : std_logic_vector(31 downto 0) := x"B3BEAFCE";
+
+    -- configuración latcheada
+    signal lat_n   : natural range 10 to 13 := 12;
+    signal lat_k   : unsigned(15 downto 0) := to_unsigned(1, 16);
+    signal lat_pad : std_logic := '1';
+    signal eng_rst : std_logic := '1';
+    signal rst_hold : unsigned(2 downto 0) := (others => '0');
+    signal n_total : unsigned(13 downto 0);   -- N
+    signal n_mask  : unsigned(12 downto 0);   -- N-1
+
+    -- entrada
+    signal i_cnt   : unsigned(12 downto 0) := (others => '0');
+    signal f_cnt   : unsigned(15 downto 0) := (others => '0');
+    signal gi_in   : unsigned(1 downto 0) := (others => '0');
+    signal ro_gi   : unsigned(1 downto 0) := (others => '0');
+    signal win_addr_s : natural range 0 to 7679 := 0;
+    signal wa_r    : natural range 0 to 7679 := 0;
+    signal win_rom_s : win_rom_t(WIN_ROM'range) := WIN_ROM;   -- ROM como RAM inicializada (M10K)
+    signal ce_i    : std_logic := '0';
+    signal ce_f    : std_logic_vector(12 downto 0) := (others => '0');   -- copias de ce_i para la FFT
+    attribute preserve : boolean;
+    attribute preserve of ce_f : signal is true;
+    signal win_q2  : std_logic_vector(15 downto 0) := (others => '0');
+    signal ro_lim  : unsigned(13 downto 0) := (others => '0');
+    signal abort_c : std_logic := '0';
+    signal din_re_i, din_im_i : signed(11 downto 0) := (others => '0');
+    signal ts_i    : unsigned(63 downto 0) := (others => '0');
+    signal xr_a, xq_a : signed(11 downto 0) := (others => '0');
+    signal va      : std_logic := '0';
+    signal vb      : std_logic := '0';
+    signal xr_b, xq_b : signed(11 downto 0) := (others => '0');
+    signal win_q   : std_logic_vector(15 downto 0) := (others => '0');
+    signal xr0, xq0 : signed(11 downto 0) := (others => '0');
+    signal v0, v1, v2 : std_logic := '0';
+    signal pr, pq  : signed(28 downto 0) := (others => '0');
+    signal xw_re, xw_im : signed(15 downto 0) := (others => '0');
+    type ts_arr_t is array (0 to 3) of unsigned(63 downto 0);
+    signal ts_par  : ts_arr_t := (others => (others => '0'));
+
+    -- FFT
+    signal f_re, f_im : signed(24 downto 0);
+    signal f_v     : std_logic;
+
+    -- etapas del acumulador
+    signal j_cnt   : unsigned(12 downto 0) := (others => '0');
+    signal fo_cnt  : unsigned(15 downto 0) := (others => '0');
+    signal par_out : std_logic := '0';
+
+    signal s0_v, s0_first, s0_last, s0_bk : std_logic := '0';
+    signal s0_re, s0_im : signed(24 downto 0) := (others => '0');
+    signal s0_k    : unsigned(12 downto 0) := (others => '0');
+
+    signal s1_v, s1_first, s1_last, s1_bk : std_logic := '0';
+    signal s1_re, s1_im : signed(24 downto 0) := (others => '0');
+    signal s1_k    : unsigned(12 downto 0) := (others => '0');
+
+    signal s2_v, s2_first, s2_last, s2_bk : std_logic := '0';
+    signal s2_k    : unsigned(12 downto 0) := (others => '0');
+    signal s2_rd   : unsigned(63 downto 0) := (others => '0');
+    signal sq_re, sq_im : unsigned(49 downto 0) := (others => '0');
+
+    signal s3_v, s3_first, s3_last, s3_bk : std_logic := '0';
+    signal s3_k    : unsigned(12 downto 0) := (others => '0');
+    signal s3_rd   : unsigned(63 downto 0) := (others => '0');
+    signal s3_p    : unsigned(50 downto 0) := (others => '0');
+
+    signal s4_v, s4_last, s4_bk : std_logic := '0';
+    signal s4_k    : unsigned(12 downto 0) := (others => '0');
+    signal s4_acc  : unsigned(63 downto 0) := (others => '0');
+
+    signal grp_done : std_logic := '0';
+    signal evt_new_group : std_logic;
+    signal done_bk  : std_logic := '0';
+
+    -- bancos
+    signal wr_en0, wr_en1 : std_logic;
+    signal q0, q1  : unsigned(63 downto 0);
+    signal ra0, ra1 : unsigned(12 downto 0);
+    signal rd0, rd1 : std_logic;
+    signal s1_rd   : unsigned(63 downto 0);
+
+    -- lectura de salida
+    signal ro_busy : std_logic := '0';
+    signal ro_bank : std_logic := '0';
+    signal ro_idx  : unsigned(13 downto 0) := (others => '0');
+    signal ro_total: unsigned(13 downto 0) := (others => '0');
+    signal ro_grp  : unsigned(31 downto 0) := (others => '0');
+    signal ro_ts   : unsigned(63 downto 0) := (others => '0');
+    signal ro_drop : std_logic := '0';
+    signal late_flag : std_logic := '0';
+    signal ro_addr : unsigned(12 downto 0);
+    signal q_sel   : unsigned(63 downto 0);
+
+    signal r1_v : std_logic := '0';
+    signal r1_kind : unsigned(1 downto 0) := "00";   -- 0 cabecera, 1 bin, 2 relleno
+    signal r1_hw : std_logic_vector(31 downto 0) := (others => '0');
+    signal r2_v : std_logic := '0';
+    signal r2_kind : unsigned(1 downto 0) := "00";
+    signal r2_hw : std_logic_vector(31 downto 0) := (others => '0');
+    signal r2_acc : unsigned(63 downto 0) := (others => '0');
+    signal r3_v : std_logic := '0';
+    signal r3_kind : unsigned(1 downto 0) := "00";
+    signal r3_hw : std_logic_vector(31 downto 0) := (others => '0');
+    signal r3_acc : unsigned(63 downto 0) := (others => '0');
+    signal r3_e : unsigned(5 downto 0) := (others => '0');
+    signal r4_v : std_logic := '0';
+    signal r4_kind : unsigned(1 downto 0) := "00";
+    signal r4_hw : std_logic_vector(31 downto 0) := (others => '0');
+    signal r4_acc : unsigned(63 downto 0) := (others => '0');
+    signal r4_e : unsigned(5 downto 0) := (others => '0');
+
+    signal c_fft, c_spec, c_late, c_words : unsigned(31 downto 0) := (others => '0');
+
+    function rev_n(j : unsigned(12 downto 0); n : natural) return unsigned is
+        variable r : unsigned(12 downto 0) := (others => '0');
+    begin
+        for b in 0 to 12 loop
+            if b < n then
+                r(n-1-b) := j(b);
+            end if;
+        end loop;
+        return r;
+    end function;
+
+    function msb_pos(a : unsigned(63 downto 0)) return natural is
+    begin
+        for b in 63 downto 0 loop
+            if a(b) = '1' then
+                return b;
+            end if;
+        end loop;
+        return 0;
+    end function;
+
+begin
+
+    -- Entradas registradas (la señal 'ce' llega con mucha lógica combinacional y tiene gran fan-out)
+    in_reg : process(clk)
+    begin
+        if rising_edge(clk) then
+            ce_i     <= ce;
+            ce_f     <= (others => ce);
+            din_re_i <= din_re;
+            din_im_i <= din_im;
+            ts_i     <= ts;
+        end if;
+    end process;
+
+    n_total <= shift_left(to_unsigned(1, 14), lat_n);
+    n_mask  <= resize(n_total - 1, 13);
+
+    -- Latch de configuración y reinicio si cambia
+    cfg_proc : process(clk)
+        variable n_c : natural range 10 to 13;
+        variable k_c : unsigned(15 downto 0);
+    begin
+        if rising_edge(clk) then
+            if to_integer(cfg_log2n) < 10 then n_c := 10;
+            elsif to_integer(cfg_log2n) > 13 then n_c := 13;
+            else n_c := to_integer(cfg_log2n); end if;
+            if cfg_k = 0 then k_c := to_unsigned(1, 16); else k_c := cfg_k; end if;
+            if rst = '1' then
+                lat_n <= n_c; lat_k <= k_c; lat_pad <= cfg_pad;
+                eng_rst <= '1';
+                rst_hold <= to_unsigned(4, 3);
+            elsif n_c /= lat_n or k_c /= lat_k or cfg_pad /= lat_pad then
+                lat_n <= n_c; lat_k <= k_c; lat_pad <= cfg_pad;
+                eng_rst <= '1';
+                rst_hold <= to_unsigned(4, 3);
+            elsif rst_hold /= 0 then
+                rst_hold <= rst_hold - 1;
+                eng_rst <= '1';
+            else
+                eng_rst <= '0';
+            end if;
+        end if;
+    end process;
+
+    -- Dirección de la ROM de la ventana: mitad simétrica
+    win_addr_p : process(all)
+        variable idx  : unsigned(11 downto 0);
+        variable mir  : std_logic;
+        variable base : natural;
+    begin
+        mir := i_cnt(lat_n - 1);
+        idx := (others => '0');
+        for b in 0 to 11 loop
+            if b < lat_n - 1 then
+                idx(b) := i_cnt(b) xor mir;
+            end if;
+        end loop;
+        case lat_n is
+            when 10     => base := 0;
+            when 11     => base := 512;
+            when 12     => base := 1536;
+            when others => base := 3584;
+        end case;
+        win_addr_s <= base + to_integer(idx);
+    end process;
+
+    -- Entrada: ventana
+    in_proc : process(clk)
+        variable t : signed(30 downto 0);
+    begin
+        if rising_edge(clk) then
+            if eng_rst = '1' then
+                i_cnt <= (others => '0');
+                f_cnt <= (others => '0');
+                gi_in <= (others => '0');
+                va <= '0'; vb <= '0'; v0 <= '0'; v1 <= '0'; v2 <= '0';
+            elsif ce_i = '1' then
+                -- paso A: se registra la muestra y la dirección de la ventana
+                wa_r <= win_addr_s;
+                xr_a <= din_re_i;
+                xq_a <= din_im_i;
+                va   <= '1';
+                -- paso W0: lectura de la ROM de la ventana, muestra alineada
+                win_q <= win_rom_s(wa_r);
+                xr_b <= xr_a;
+                xq_b <= xq_a;
+                vb <= va;
+                -- paso W0b: registro de salida de la ROM
+                win_q2 <= win_q;
+                xr0 <= xr_b;
+                xq0 <= xq_b;
+                v0 <= vb;
+                if i_cnt = 0 and f_cnt = 0 then
+                    ts_par(to_integer(gi_in)) <= ts_i;
+                end if;
+                if i_cnt = n_mask then
+                    i_cnt <= (others => '0');
+                    if f_cnt = lat_k - 1 then
+                        f_cnt <= (others => '0');
+                        gi_in <= gi_in + 1;
+                    else
+                        f_cnt <= f_cnt + 1;
+                    end if;
+                else
+                    i_cnt <= i_cnt + 1;
+                end if;
+                -- W1: producto con la ventana (sin signo, 16 bit)
+                pr <= xr0 * signed('0' & unsigned(win_q2));
+                pq <= xq0 * signed('0' & unsigned(win_q2));
+                v1 <= v0;
+                -- W2: redondeo (x*wq + 1024) >> 11
+                t := resize(pr, 31) + 1024;
+                xw_re <= t(26 downto 11);
+                t := resize(pq, 31) + 1024;
+                xw_im <= t(26 downto 11);
+                v2 <= v1;
+            end if;
+        end if;
+    end process;
+
+    u_fft : entity work.spec_fft
+        port map (
+            clk => clk, rst => eng_rst, ce => ce_f,
+            log2n => to_unsigned(lat_n, 4),
+            din_re => xw_re, din_im => xw_im, vin => v2,
+            dout_re => f_re, dout_im => f_im, vout => f_v
+        );
+
+    -- Salida de la FFT -> etapa S0 (dirección bit-invertida, marcas de primera/última)
+    s0_proc : process(clk)
+        variable sqv_re, sqv_im : signed(49 downto 0);
+    begin
+        if rising_edge(clk) then
+            if eng_rst = '1' then
+                j_cnt <= (others => '0');
+                fo_cnt <= (others => '0');
+                par_out <= '0';
+                s0_v <= '0'; s1_v <= '0'; s2_v <= '0'; s3_v <= '0'; s4_v <= '0';
+                grp_done <= '0';
+            else
+                grp_done <= '0';
+                if ce_i = '1' then
+                    s0_v <= f_v;
+                    if f_v = '1' then
+                        s0_re <= f_re;
+                        s0_im <= f_im;
+                        s0_k  <= rev_n(j_cnt, lat_n);
+                        if fo_cnt = 0 then s0_first <= '1'; else s0_first <= '0'; end if;
+                        if j_cnt = n_mask and fo_cnt = lat_k - 1 then s0_last <= '1'; else s0_last <= '0'; end if;
+                        s0_bk <= par_out;
+                        if j_cnt = n_mask then
+                            j_cnt <= (others => '0');
+                            c_fft <= c_fft + 1;
+                            if fo_cnt = lat_k - 1 then
+                                fo_cnt <= (others => '0');
+                                par_out <= not par_out;
+                            else
+                                fo_cnt <= fo_cnt + 1;
+                            end if;
+                        else
+                            j_cnt <= j_cnt + 1;
+                        end if;
+                    end if;
+                    -- S1: lectura de la RAM lanzada con la dirección de S0
+                    s1_v <= s0_v; s1_re <= s0_re; s1_im <= s0_im; s1_k <= s0_k;
+                    s1_first <= s0_first; s1_last <= s0_last; s1_bk <= s0_bk;
+                    -- S2: cuadrados
+                    s2_v <= s1_v; s2_k <= s1_k; s2_first <= s1_first; s2_last <= s1_last; s2_bk <= s1_bk;
+                    s2_rd <= s1_rd;
+                    sqv_re := s1_re * s1_re;
+                    sqv_im := s1_im * s1_im;
+                    sq_re <= unsigned(sqv_re(49 downto 0));
+                    sq_im <= unsigned(sqv_im(49 downto 0));
+                    -- S3: suma de cuadrados
+                    s3_v <= s2_v; s3_k <= s2_k; s3_first <= s2_first; s3_last <= s2_last; s3_bk <= s2_bk;
+                    s3_rd <= s2_rd;
+                    s3_p <= resize(sq_re, 51) + resize(sq_im, 51);
+                    -- S4: acumulación
+                    s4_v <= s3_v; s4_k <= s3_k; s4_last <= s3_last; s4_bk <= s3_bk;
+                    if s3_first = '1' then
+                        s4_acc <= resize(s3_p, 64);
+                    else
+                        s4_acc <= s3_rd + resize(s3_p, 64);
+                    end if;
+                    -- escritura en la RAM (en este mismo flanco, con los registros S4 actuales)
+                    if s4_v = '1' and s4_last = '1' then
+                        grp_done <= '1';
+                        done_bk  <= s4_bk;
+                    end if;
+                end if;
+            end if;
+            if clr = '1' then
+                c_fft <= (others => '0');
+            end if;
+        end if;
+    end process;
+
+    -- primer elemento de un grupo nuevo (para detectar que el banco aún se está leyendo)
+    evt_new_group <= (ce_i and f_v) when (j_cnt = 0 and fo_cnt = 0) else '0';
+
+    -- Bancos
+    wr_en0 <= ce_i and s4_v when s4_bk = '0' else '0';
+    wr_en1 <= ce_i and s4_v when s4_bk = '1' else '0';
+    ro_addr <= to_unsigned(0, 13) when ro_busy = '0' else
+               resize(ro_idx - 8, 13) + resize(n_total / 2, 13);
+
+    ra0 <= ro_addr and n_mask when (ro_busy = '1' and ro_bank = '0') else s0_k;
+    ra1 <= ro_addr and n_mask when (ro_busy = '1' and ro_bank = '1') else s0_k;
+    rd0 <= '1' when (ro_busy = '1' and ro_bank = '0') else ce_i;
+    rd1 <= '1' when (ro_busy = '1' and ro_bank = '1') else ce_i;
+
+    u_bank0 : entity work.spec_acc_ram
+        port map (clk => clk, we => wr_en0, waddr => s4_k, wdata => s4_acc,
+                  raddr => ra0, rden => rd0, q => q0);
+    u_bank1 : entity work.spec_acc_ram
+        port map (clk => clk, we => wr_en1, waddr => s4_k, wdata => s4_acc,
+                  raddr => ra1, rden => rd1, q => q1);
+
+    s1_rd <= q1 when s1_bk = '1' else q0;
+    q_sel <= q1 when ro_bank = '1' else q0;
+
+    -- Lectura de salida
+    ro_proc : process(clk)
+        variable hw : std_logic_vector(31 downto 0);
+        variable e  : natural;
+        variable m  : unsigned(63 downto 0);
+        variable tot : unsigned(13 downto 0);
+    begin
+        if rising_edge(clk) then
+            if eng_rst = '1' then
+                ro_busy <= '0';
+                ro_grp  <= (others => '0');
+                ro_gi   <= (others => '0');
+                r1_v <= '0'; r2_v <= '0'; r3_v <= '0';
+                ro_drop <= '0';
+                late_flag <= '0';
+            else
+                -- aborto: el grupo nuevo va a escribir en el banco que aún se está leyendo
+                ro_lim <= n_total + 8;
+                if evt_new_group = '1' and ro_busy = '1' and ro_bank = par_out and ro_idx < ro_lim then
+                    abort_c <= '1';
+                else
+                    abort_c <= '0';
+                end if;
+                if abort_c = '1' and ro_busy = '1' then
+                    ro_busy   <= '0';
+                    late_flag <= '1';
+                    c_late    <= c_late + 1;
+                end if;
+                -- inicio / avance
+                if grp_done = '1' then
+                    if ro_busy = '1' and ro_idx < ro_total - 1 then
+                        c_late <= c_late + 1;     -- se corta una trama sin terminar
+                    end if;
+                    ro_busy <= '1';
+                    ro_idx  <= (others => '0');
+                    ro_bank <= done_bk;
+                    ro_ts <= ts_par(to_integer(ro_gi));
+                    ro_gi <= ro_gi + 1;
+                    ro_drop <= late_flag;
+                    tot := n_total + 8;
+                    if lat_pad = '1' then
+                        tot := (tot + 2047) and to_unsigned(16#3800#, 14);   -- múltiplo de 2048 (hasta 10240)
+                    end if;
+                    ro_total <= tot;
+                    late_flag <= '0';
+                    c_spec <= c_spec + 1;
+                elsif ro_busy = '1' then
+                    ro_idx <= ro_idx + 1;
+                    if ro_idx = ro_total - 1 then
+                        ro_busy <= '0';
+                    end if;
+                end if;
+
+                -- R1: clasificar el índice y preparar la palabra de cabecera
+                r1_v <= ro_busy;
+                if ro_idx < 8 then
+                    r1_kind <= "00";
+                elsif ro_idx < ro_lim then
+                    r1_kind <= "01";
+                else
+                    r1_kind <= "10";
+                end if;
+                case to_integer(ro_idx(2 downto 0)) is
+                    when 0 => hw := MAGIC0;
+                    when 1 => hw := MAGIC1;
+                    when 2 => hw := std_logic_vector(lat_k) & std_logic_vector(resize(n_total, 16));
+                    when 3 => hw := std_logic_vector(ro_grp);
+                    when 4 => hw := std_logic_vector(ro_ts(31 downto 0));
+                    when 5 => hw := std_logic_vector(ro_ts(63 downto 32));
+                    when 6 => hw := "000000000000000" & ro_drop & x"0108";
+                    when others => hw := std_logic_vector(resize(ro_total, 32));
+                end case;
+                r1_hw <= hw;
+                if ro_busy = '1' and ro_idx = 7 then
+                    ro_grp <= ro_grp + 1;
+                end if;
+                -- R2: dato de la RAM
+                r2_v <= r1_v; r2_kind <= r1_kind; r2_hw <= r1_hw; r2_acc <= q_sel;
+                -- R3: exponente
+                r3_v <= r2_v; r3_kind <= r2_kind; r3_hw <= r2_hw; r3_acc <= r2_acc;
+                e := msb_pos(r2_acc);
+                if e > 25 then r3_e <= to_unsigned(e - 25, 6); else r3_e <= (others => '0'); end if;
+            end if;
+        if clr = '1' then
+                c_spec <= (others => '0');
+                c_late <= (others => '0');
+            end if;
+        end if;
+    end process;
+
+    -- R4: desplazamiento grueso (múltiplos de 8); R5: desplazamiento fino y palabra de salida
+    out_proc : process(clk)
+        variable m : unsigned(63 downto 0);
+    begin
+        if rising_edge(clk) then
+            if eng_rst = '1' then
+                out_valid <= '0';
+                out_word <= (others => '0');
+                r4_v <= '0';
+            else
+                r4_v <= r3_v; r4_kind <= r3_kind; r4_hw <= r3_hw; r4_e <= r3_e;
+                r4_acc <= shift_right(r3_acc, 8 * to_integer(r3_e(5 downto 3)));
+                out_valid <= r4_v;
+                if r4_kind = "01" then
+                    m := shift_right(r4_acc, to_integer(r4_e(2 downto 0)));
+                    out_word <= std_logic_vector(r4_e) & std_logic_vector(m(25 downto 0));
+                elsif r4_kind = "00" then
+                    out_word <= r4_hw;
+                else
+                    out_word <= (others => '0');
+                end if;
+                if r4_v = '1' then
+                    c_words <= c_words + 1;
+                end if;
+            end if;
+            if clr = '1' then
+                c_words <= (others => '0');
+            end if;
+        end if;
+    end process;
+
+    cnt_fft_frames  <= c_fft;
+    cnt_spec_frames <= c_spec;
+    cnt_late        <= c_late;
+    cnt_words       <= c_words;
+
+end architecture;
diff --git a/hdl/fpga/platforms/bladerf-micro/vhdl/lab/spec_fft.vhd b/hdl/fpga/platforms/bladerf-micro/vhdl/lab/spec_fft.vhd
new file mode 100644
index 0000000..2195215
--- /dev/null
+++ b/hdl/fpga/platforms/bladerf-micro/vhdl/lab/spec_fft.vhd
@@ -0,0 +1,101 @@
+-- spec_fft.vhd — FFT de flujo (SDF radix-2^2) de N = 2^n puntos, n = 10..13.
+--
+-- Cadena fija de 13 etapas (E = 12..0). Para N = 2^n la señal entra directamente
+-- en la etapa E0 = n-1 y las etapas de mayor E quedan inactivas. Una etapa con E
+-- par y E != E0 es de tipo II (rotación -j en las secciones impares) y la sigue un
+-- multiplicador de twiddles (sdf_mult); si E = E0 es par la etapa es "sola" (una
+-- mariposa radix-2 con su propio twiddle). Si E0 es impar todo son pares I/II.
+-- La salida sale en orden bit-invertido: la posición j corresponde al bin
+-- bitrev_n(j). Datos: entrada de 16 bits con signo, salida de 25 bits.
+
+library ieee;
+    use ieee.std_logic_1164.all;
+    use ieee.numeric_std.all;
+
+entity spec_fft is
+    port (
+        clk      : in  std_logic;
+        rst      : in  std_logic;
+        ce       : in  std_logic_vector(12 downto 0);   -- una copia por etapa (reduce el fan-out)
+        log2n    : in  unsigned(3 downto 0);
+        din_re   : in  signed(15 downto 0);
+        din_im   : in  signed(15 downto 0);
+        vin      : in  std_logic;
+        dout_re  : out signed(24 downto 0);
+        dout_im  : out signed(24 downto 0);
+        vout     : out std_logic
+    );
+end entity;
+
+architecture rtl of spec_fft is
+
+    type cplx_arr_t is array (0 to 13) of signed(24 downto 0);
+
+    -- Salida (tras el multiplicador, si lo hay) de cada etapa; el índice E+1 es la
+    -- entrada de la etapa E. La posición 13 es la entrada de la etapa 12 (sin cadena previa).
+    signal s_re, s_im : cplx_arr_t := (others => (others => '0'));
+    signal s_v        : std_logic_vector(0 to 13) := (others => '0');
+
+    signal ext_re, ext_im : signed(24 downto 0);
+
+begin
+
+    ext_re <= resize(din_re, 25);
+    ext_im <= resize(din_im, 25);
+
+    -- Entrada de la cadena: nada llega a la etapa 12 desde "arriba"
+    s_re(13) <= (others => '0');
+    s_im(13) <= (others => '0');
+    s_v(13)  <= '0';
+
+    gen_stage : for e in 0 to 12 generate
+        signal first    : std_logic;
+        signal st_in_re, st_in_im : signed(24 downto 0);
+        signal st_in_v  : std_logic;
+        signal st_out_re, st_out_im : signed(24 downto 0);
+        signal st_out_v : std_logic;
+        signal ii       : std_logic;
+        signal lone     : std_logic;
+    begin
+        process(clk) begin
+            if rising_edge(clk) then
+                if to_integer(log2n) = e + 1 then first <= '1'; else first <= '0'; end if;
+            end if;
+        end process;
+        ii    <= '1' when (e mod 2 = 0) and first = '0' else '0';
+        lone  <= first when (e mod 2 = 0) else '0';
+
+        st_in_re <= ext_re when first = '1' else s_re(e+1);
+        st_in_im <= ext_im when first = '1' else s_im(e+1);
+        st_in_v  <= vin    when first = '1' else s_v(e+1);
+
+        u_stage : entity work.sdf_stage
+            generic map (E => e)
+            port map (
+                clk => clk, rst => rst, ce => ce(e), ii_mode => ii,
+                din_re => st_in_re, din_im => st_in_im, vin => st_in_v,
+                dout_re => st_out_re, dout_im => st_out_im, vout => st_out_v
+            );
+
+        gen_mult : if (e mod 2 = 0) and (e >= 2) generate
+            u_mult : entity work.sdf_mult
+                generic map (E => e)
+                port map (
+                    clk => clk, rst => rst, ce => ce(e), lone => lone,
+                    din_re => st_out_re, din_im => st_out_im, vin => st_out_v,
+                    dout_re => s_re(e), dout_im => s_im(e), vout => s_v(e)
+                );
+        end generate;
+
+        gen_nomult : if not ((e mod 2 = 0) and (e >= 2)) generate
+            s_re(e) <= st_out_re;
+            s_im(e) <= st_out_im;
+            s_v(e)  <= st_out_v;
+        end generate;
+    end generate;
+
+    dout_re <= s_re(0);
+    dout_im <= s_im(0);
+    vout    <= s_v(0);
+
+end architecture;
