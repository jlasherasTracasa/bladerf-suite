+ * build_bladerf.sh compila el software del Nios con LAB_BUILD=1 cuando rev = lab. */
+#ifdef BLADERF_LAB_BUILD
+#define FPGA_VERSION_PATCH      101
+#else
 #define FPGA_VERSION_PATCH      0
+#endif
 #define FPGA_VERSION ((uint32_t)( FPGA_VERSION_MAJOR        | \
                                  (FPGA_VERSION_MINOR << 8)  | \
                                  (FPGA_VERSION_PATCH << 16) ) )
