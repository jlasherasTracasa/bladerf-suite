+    end generate;
+
+    U_sync_adf_muxout : entity work.synchronizer
+        generic map (
+            RESET_LEVEL         =>  '0'
+        )
+        port map (
+            reset               =>  '0',
+            clock               =>  sys_clock,
+            async               =>  adf_muxout,
+            sync                =>  rffe_gpio.i.adf_muxout
+        );
+
+    generate_sync_xb_gpio_in : for i in exp_gpio'range generate
+        U_sync_xb_gpio_in : entity work.synchronizer
+          generic map (
+            RESET_LEVEL         =>  '0'
+          ) port map (
+            reset               =>  '0',
+            clock               =>  sys_clock,
+            async               =>  exp_gpio(i),
+            sync                =>  nios_xb_gpio_in(i)
+          );
+    end generate;
+
+    U_sync_rx_enable : entity work.synchronizer
+        generic map (
+            RESET_LEVEL =>  '0'
+        )
+        port map (
+            reset       =>  rx_reset,
+            clock       =>  rx_clock,
+            async       =>  rx_enable_pclk,
+            sync        =>  rx_enable
+        );
+
+    U_sync_tx_enable : entity work.synchronizer
+        generic map (
+            RESET_LEVEL =>  '0'
+        )
+        port map (
+            reset       =>  tx_reset,
+            clock       =>  tx_clock,
+            async       =>  tx_enable_pclk,
+            sync        =>  tx_enable
+        );
+
+
+    -- ========================================================================
+    -- HANDSHAKES
+    -- ========================================================================
+
+    drive_handshake_timestamp : process( fx3_pclk_pll, sys_reset_pclk )
+    begin
+        if( sys_reset_pclk = '1' ) then
+            timestamp_req <= '0';
+        elsif( rising_edge(fx3_pclk_pll) ) then
+            if( meta_en_pclk = '0' ) then
+                timestamp_req <= '0';
+            else
+                if( timestamp_ack = '0' ) then
+                    timestamp_req <= '1';
+                elsif( timestamp_ack = '1' ) then
+                    timestamp_req <= '0';
+                end if;
+            end if;
+        end if;
+    end process;
+
+    U_handshake_timestamp : entity work.handshake
+        generic map (
+            DATA_WIDTH          =>  tx_timestamp'length
+        )
+        port map (
+            source_clock        =>  tx_clock,
+            source_reset        =>  tx_reset,
+            source_data         =>  std_logic_vector(tx_timestamp),
+
+            dest_clock          =>  fx3_pclk_pll,
+            dest_reset          =>  sys_reset_pclk,
+            unsigned(dest_data) =>  fx3_timestamp,
+            dest_req            =>  timestamp_req,
+            dest_ack            =>  timestamp_ack
+        );
+
+end architecture;
diff --git a/hdl/fpga/platforms/bladerf-micro/vhdl/lab/lab_cdc_bus.vhd b/hdl/fpga/platforms/bladerf-micro/vhdl/lab/lab_cdc_bus.vhd
new file mode 100644
index 0000000..7773bf2
--- /dev/null
+++ b/hdl/fpga/platforms/bladerf-micro/vhdl/lab/lab_cdc_bus.vhd
@@ -0,0 +1,58 @@
+-- lab_cdc_bus.vhd — Cruce de reloj de un bus de datos casi estático mediante el
+-- 'handshake' de Nuand (ya usado para el timestamp): el origen retiene el dato
+-- cuando el destino lo pide y el destino lo captura al recibir el ack. El destino
+-- repite la petición continuamente, así que el bus se refresca solo.
+-- Si el reloj de origen o destino no corre (p. ej. el AD9361 sin inicializar) el
+-- bus simplemente no se actualiza: nunca bloquea nada.
+
+library ieee;
+    use ieee.std_logic_1164.all;
+
+entity lab_cdc_bus is
+    generic (
+        W : positive := 32
+    );
+    port (
+        src_clk  : in  std_logic;
+        src_rst  : in  std_logic;
+        src_data : in  std_logic_vector(W-1 downto 0);
+        dst_clk  : in  std_logic;
+        dst_rst  : in  std_logic;
+        dst_data : out std_logic_vector(W-1 downto 0) := (others => '0')
+    );
+end entity;
+
+architecture rtl of lab_cdc_bus is
+    signal hs_data  : std_logic_vector(W-1 downto 0);
+    signal req, ack, ack_d : std_logic := '0';
+begin
+
+    u_hs : entity work.handshake
+        generic map (DATA_WIDTH => W)
+        port map (
+            source_reset => src_rst, source_clock => src_clk, source_data => src_data,
+            dest_reset   => dst_rst, dest_clock   => dst_clk, dest_data   => hs_data,
+            dest_req     => req,     dest_ack     => ack
+        );
+
+    process(dst_clk)
+    begin
+        if rising_edge(dst_clk) then
+            if dst_rst = '1' then
+                req   <= '0';
+                ack_d <= '0';
+            else
+                ack_d <= ack;
+                if ack = '0' then
+                    req <= '1';
+                else
+                    req <= '0';
+                end if;
+                if ack = '1' and ack_d = '0' then
+                    dst_data <= hs_data;
+                end if;
+            end if;
+        end if;
+    end process;
+
+end architecture;
diff --git a/hdl/fpga/platforms/bladerf-micro/vhdl/lab/lab_regs.vhd b/hdl/fpga/platforms/bladerf-micro/vhdl/lab/lab_regs.vhd
new file mode 100644
index 0000000..cfda057
--- /dev/null
+++ b/hdl/fpga/platforms/bladerf-micro/vhdl/lab/lab_regs.vhd
@@ -0,0 +1,125 @@
+-- lab_regs.vhd — Banco de registros Wishbone de la revisión "lab".
+--
+-- Cuelga del maestro Wishbone del Nios (bladerf_wishbone_master_read/write). El
+-- maestro presenta cada petición durante UN ciclo (wb_cyc_o) y espera exactamente
+-- un ack; este esclavo responde SIEMPRE, también a direcciones no mapeadas, para
+-- no colgar nunca el Nios. La dirección es de palabra: índice = adr(7:0) = addr_host/4.
+--
+-- Mapa (índice de palabra):
+--   0  ID         RO  0x4C414231 "LAB1"
+--   1  VERSION    RO  0x00010001 (mayor.menor de la lab = 1.0, revisión de banco 1)
+--   2  FEATURES   RO  bit0 motor de espectro; [7:4]=10 (log2 Nmin); [11:8]=13 (log2 Nmax)
+--   3  SCRATCH    RW  32 bit
+--   4  SCRATCH_N  RO  ~SCRATCH
+--   5  SPEC_LOG2N RW  [3:0] log2 N (10..13), por defecto 12
+--   6  SPEC_K     RW  [15:0] tramas promediadas (>= 1), por defecto 16
+--   7  SPEC_CTRL  RW  bit0 PAD (completar la trama a múltiplo de 2048 palabras), por defecto 1
+--   8  CNT_SAMPLES  RO  muestras RX del canal activo (módulo 2^32)
+--   9  CNT_FIFO_OVF RO  escrituras con la FIFO de muestras llena
+--  10  CNT_FFT      RO  tramas de FFT procesadas
+--  11  CNT_SPEC     RO  tramas de espectro entregadas
+--  12  CNT_LATE     RO  tramas descartadas por lectura tardía
+--  13  CNT_WORDS    RO  palabras de espectro emitidas
+--  14  STATUS       RO  bit0 motor activo (rx_mux = 3 y RX habilitado)
+--  15  CLEAR        WO  cualquier escritura pone a cero los contadores (lee el nº de borrados)
+
+library ieee;
+    use ieee.std_logic_1164.all;
+    use ieee.numeric_std.all;
+
+entity lab_regs is
+    port (
+        clk        : in  std_logic;
+        rst        : in  std_logic;
+        -- Wishbone (esclavo)
+        wb_cyc     : in  std_logic;
+        wb_adr     : in  std_logic_vector(31 downto 0);
+        wb_dat_w   : in  std_logic_vector(31 downto 0);
+        wb_we      : in  std_logic;
+        wb_dat_r   : out std_logic_vector(31 downto 0) := (others => '0');
+        wb_ack     : out std_logic := '0';
+        -- configuración hacia el dominio de RX
+        cfg_log2n  : out unsigned(3 downto 0);
+        cfg_k      : out unsigned(15 downto 0);
+        cfg_pad    : out std_logic;
+        cfg_clear  : out unsigned(7 downto 0);
+        -- contadores desde el dominio de RX (ya sincronizados a clk)
+        c_samples  : in  unsigned(31 downto 0);
+        c_ovf      : in  unsigned(31 downto 0);
+        c_fft      : in  unsigned(31 downto 0);
+        c_spec     : in  unsigned(31 downto 0);
+        c_late     : in  unsigned(31 downto 0);
+        c_words    : in  unsigned(31 downto 0);
+        st_active  : in  std_logic
+    );
+end entity;
+
+architecture rtl of lab_regs is
+    constant ID_VALUE      : std_logic_vector(31 downto 0) := x"4C414231";
+    constant VERSION_VALUE : std_logic_vector(31 downto 0) := x"00010001";
+    constant FEATURES      : std_logic_vector(31 downto 0) := x"00000DA1";
+
+    signal scratch   : std_logic_vector(31 downto 0) := x"00000000";
+    signal r_log2n   : unsigned(3 downto 0) := to_unsigned(12, 4);
+    signal r_k       : unsigned(15 downto 0) := to_unsigned(16, 16);
+    signal r_pad     : std_logic := '1';
+    signal r_clear   : unsigned(7 downto 0) := (others => '0');
+    signal cyc_d     : std_logic := '0';
+begin
+
+    cfg_log2n <= r_log2n;
+    cfg_k     <= r_k;
+    cfg_pad   <= r_pad;
+    cfg_clear <= r_clear;
+
+    process(clk)
+        variable idx : natural range 0 to 255;
+        variable rv  : std_logic_vector(31 downto 0);
+    begin
+        if rising_edge(clk) then
+            wb_ack <= '0';
+            cyc_d  <= wb_cyc;
+            if rst = '1' then
+                scratch <= (others => '0');
+                r_log2n <= to_unsigned(12, 4);
+                r_k     <= to_unsigned(16, 16);
+                r_pad   <= '1';
+                r_clear <= (others => '0');
+            elsif wb_cyc = '1' and cyc_d = '0' then
+                idx := to_integer(unsigned(wb_adr(7 downto 0)));
+                case idx is
+                    when 0  => rv := ID_VALUE;
+                    when 1  => rv := VERSION_VALUE;
+                    when 2  => rv := FEATURES;
+                    when 3  => rv := scratch;
+                    when 4  => rv := not scratch;
+                    when 5  => rv := x"0000000" & std_logic_vector(r_log2n);
+                    when 6  => rv := x"0000" & std_logic_vector(r_k);
+                    when 7  => rv := x"0000000" & "000" & r_pad;
+                    when 8  => rv := std_logic_vector(c_samples);
+                    when 9  => rv := std_logic_vector(c_ovf);
+                    when 10 => rv := std_logic_vector(c_fft);
+                    when 11 => rv := std_logic_vector(c_spec);
+                    when 12 => rv := std_logic_vector(c_late);
+                    when 13 => rv := std_logic_vector(c_words);
+                    when 14 => rv := x"0000000" & "000" & st_active;
+                    when 15 => rv := x"000000" & std_logic_vector(r_clear);
+                    when others => rv := x"BAD0BAD0";
+                end case;
+                if wb_we = '1' then
+                    case idx is
+                        when 3  => scratch <= wb_dat_w;
+                        when 5  => r_log2n <= unsigned(wb_dat_w(3 downto 0));
+                        when 6  => r_k     <= unsigned(wb_dat_w(15 downto 0));
+                        when 7  => r_pad   <= wb_dat_w(0);
+                        when 15 => r_clear <= r_clear + 1;
+                        when others => null;
+                    end case;
+                end if;
+                wb_dat_r <= rv;
+                wb_ack   <= '1';
+            end if;
+        end if;
+    end process;
+
+end architecture;
