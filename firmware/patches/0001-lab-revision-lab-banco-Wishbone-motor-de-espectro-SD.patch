+# bladerf-lab.sdc — Restricciones adicionales de la revisión "lab" (BladeRF Lab).
+#
+# El motor de espectro avanza con un habilitador 'ce' que es un pulso por muestra del
+# AD9361 y, en los modos soportados (tasa normal, <= 61,44 Msps), dos pulsos 'ce'
+# consecutivos distan SIEMPRE >= 2 ciclos de rx_clock (adc_valid alterna cada ciclo y
+# bladerf-hosted lo convierte en un pulso por flanco). Todos los registros de la
+# cadena de datos del motor se actualizan solo con 'ce', de modo que cada camino
+# registro->registro entre ellos dispone de 2 ciclos (multiciclo 2, retención 1).
+# Quedan fuera (un solo ciclo) los habilitadores ce_i/ce_f, la lectura de salida a
+# 1 palabra/ciclo, los contadores y la configuración.
+set lab_ce_regs [get_registers {*spec_engine:U_spec_engine|spec_fft:u_fft|*}]
+set_multicycle_path -setup 2 -end -from $lab_ce_regs -to $lab_ce_regs
+set_multicycle_path -hold  1 -end -from $lab_ce_regs -to $lab_ce_regs
+
+set lab_ce_pipe [get_registers {*spec_engine:U_spec_engine|xr_a[*] *spec_engine:U_spec_engine|xq_a[*]
+                                *spec_engine:U_spec_engine|xr_b[*] *spec_engine:U_spec_engine|xq_b[*]
+                                *spec_engine:U_spec_engine|xr0[*]  *spec_engine:U_spec_engine|xq0[*]
+                                *spec_engine:U_spec_engine|wa_r[*] *spec_engine:U_spec_engine|win_q[*]
+                                *spec_engine:U_spec_engine|win_q2[*]
+                                *spec_engine:U_spec_engine|pr[*]   *spec_engine:U_spec_engine|pq[*]
+                                *spec_engine:U_spec_engine|xw_re[*] *spec_engine:U_spec_engine|xw_im[*]
+                                *spec_engine:U_spec_engine|i_cnt[*] *spec_engine:U_spec_engine|f_cnt[*]
+                                *spec_engine:U_spec_engine|s0_*  *spec_engine:U_spec_engine|s1_*
+                                *spec_engine:U_spec_engine|s2_*  *spec_engine:U_spec_engine|s3_*
+                                *spec_engine:U_spec_engine|s4_*  *spec_engine:U_spec_engine|sq_*
+                                *spec_engine:U_spec_engine|j_cnt[*] *spec_engine:U_spec_engine|fo_cnt[*]}]
+set_multicycle_path -setup 2 -end -from $lab_ce_pipe -to [concat $lab_ce_pipe $lab_ce_regs]
+set_multicycle_path -hold  1 -end -from $lab_ce_pipe -to [concat $lab_ce_pipe $lab_ce_regs]
+set_multicycle_path -setup 2 -end -from $lab_ce_regs -to $lab_ce_pipe
+set_multicycle_path -hold  1 -end -from $lab_ce_regs -to $lab_ce_pipe
